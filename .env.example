# Disposable local development only. Never reuse for deployed services.
JS_DATABASE_URL=postgresql+psycopg://journeysignal_demo:disposable_demo_only@127.0.0.1:5432/journeysignal
JS_API_DATABASE_URL=postgresql+psycopg://journeysignal_reader:disposable_reader_only@127.0.0.1:5432/journeysignal
# Use this owner URL ONLY for Alembic; it overrides JS_DATABASE_URL in migrations.
JS_MIGRATION_DATABASE_URL=postgresql+psycopg://journeysignal_owner:disposable_owner_only@127.0.0.1:5432/journeysignal
JS_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
JS_KAFKA_TOPIC=journeysignal.events.v1
JS_KAFKA_GROUP_ID=journeysignal-worker-v1
JS_FRESHNESS_SECONDS=300
JS_FUTURE_SKEW_SECONDS=30
JS_WORKER_METRICS_PORT=9101
